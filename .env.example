# Copiez ce fichier en .env.local et remplissez les valeurs.
# .env.local n'est jamais commité (voir .gitignore).

# --- Supabase ---
# URL et clé "anon" du projet : Project Settings > API dans le tableau de bord Supabase.
# Ces deux valeurs sont publiques par conception (préfixe NEXT_PUBLIC_) et peuvent
# être exposées au navigateur.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé "service_role" : Project Settings > API. STRICTEMENT SECRÈTE.
# Ne jamais préfixer par NEXT_PUBLIC_, ne jamais exposer au navigateur, ne jamais committer.
SUPABASE_SERVICE_ROLE_KEY=

# --- Emails (Resend) ---
# Clé API Resend : https://resend.com/api-keys — STRICTEMENT SECRÈTE.
RESEND_API_KEY=

# Adresse d'envoi. Pour démarrer sans domaine vérifié, laissez vide
# (une adresse de test @resend.dev sera utilisée automatiquement).
EMAIL_FROM=

# Adresse qui reçoit les notifications de nouvelles demandes.
# Laissez vide pour utiliser l'adresse Evorya par défaut (evoryaproject@gmail.com).
CONTACT_NOTIFICATION_EMAIL=

# --- Développement local uniquement (sans effet en production) ---
# Pour tester le site (y compris /admin) depuis votre téléphone sur le même
# Wi-Fi que votre ordinateur : lancez `npm run dev`, notez l'adresse "Network"
# affichée (ex: 192.168.1.23), et renseignez-la ici sans le port. Redémarrez
# le serveur après modification.
DEV_LAN_ORIGINS=
